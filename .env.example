# Server-only Neon Postgres connection strings. Do not commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@UNPOOLED_HOST/DATABASE?sslmode=require

# Server-only token for a PRIVATE Vercel Blob store.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_REPLACE_ME
